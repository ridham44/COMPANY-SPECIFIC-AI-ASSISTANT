APP_NAME=Company Knowledge Assistant
ENVIRONMENT=development

OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_TEMPERATURE=0.2
LLM_REQUEST_TIMEOUT_SECONDS=120

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

RETRIEVAL_TOP_K=5
RELEVANCE_SCORE_THRESHOLD=0.5
CHUNK_SIZE=500
CHUNK_OVERLAP=75

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=company_assistant

# leave QDRANT_LOCAL_PATH empty to use QDRANT_URL (a real Qdrant server, e.g. in docker-compose).
# set it to a folder path for local file-based storage, or ":memory:" for tests/scratch runs -
# either way no separate Qdrant server is needed.
QDRANT_URL=http://localhost:6333
QDRANT_LOCAL_PATH=./qdrant_data

STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
